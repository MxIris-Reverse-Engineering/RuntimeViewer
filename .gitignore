/RuntimeViewerCommandLine/Derived/
/RuntimeViewerPrecompiledLibraries/swift-syntax/swift-syntax.xcodeproj
/RuntimeViewerPrecompiledLibraries/swift-syntax/Derived/
# `tuist install` caches each local package's evaluated manifest in its .build directory; the other
# four packages already ignore theirs.
/RuntimeViewerPrecompiledLibraries/swift-syntax/.build/
# FetchSourceEditorScript.sh downloads the reconstructed SourceEditor frameworks here, and works in a
# scratch directory beside them; only PinnedRelease.txt is committed.
/RuntimeViewerPrecompiledLibraries/SourceEditor/Frameworks/
/RuntimeViewerPrecompiledLibraries/SourceEditor/.Fetch.*/
/Tuist/.build/
# The local dependency mode's dependency checkouts when /Volumes/DerivedData is not mounted, and the
# file recording that mode for this checkout (`./TuistScript.sh <command> --local-dependencies`).
/Tuist/.build-LocalDependencies/
/Tuist/.local-dependencies
# `./TuistScript.sh install` starts it from RuntimeViewer-Debug.xcworkspace's lock file every time;
# the native lock files are the ones to commit.
/Tuist/Package.resolved
