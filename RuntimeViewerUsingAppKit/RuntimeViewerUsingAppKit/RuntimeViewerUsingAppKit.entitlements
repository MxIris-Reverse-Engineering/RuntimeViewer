<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Needed to dlopen Xcode's private SourceEditor frameworks (proposal 0009).

	     Strictly speaking this may be unnecessary: library validation permits code signed
	     by Apple or by the same team, and those frameworks are Apple-signed. It cannot be
	     confirmed on the development machine, which has library validation switched off,
	     and the failure mode if the reasoning is wrong is that the editor silently never
	     loads on user machines. A standard hardened-runtime exception that does not affect
	     notarization is the cheaper side of that bet. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
