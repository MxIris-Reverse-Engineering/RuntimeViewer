#include "../Version.xcconfig"

// The Mac Catalyst helper is built as a target dependency of the macOS app, so it pins its own
// platform: Swift Build builds a dependency for the platform named by its own SDKROOT /
// SDK_VARIANT, and only SDKROOT = auto takes the app's. The usual SDKROOT = iphoneos plus
// SUPPORTS_MACCATALYST = YES would build an iphoneos product under the app's macOS destination.
// AGENTS.md, "Embedded non-macOS products", has the whole story.
SDKROOT = macosx
SDK_VARIANT = iosmac
SUPPORTED_PLATFORMS = macosx
SUPPORTS_MACCATALYST = YES

// The SDK's Mac Catalyst variant adds $(TOOLCHAIN_DIR)/usr/lib/swift/maccatalyst to the library
// search paths, and TOOLCHAIN_DIR is the first toolchain in TOOLCHAINS. Xcode 27.2 puts the
// downloadable Metal toolchain first, above any target setting, and it has no such directory, so
// every link warns "search path ... not found". Nothing narrower works: Swift Build appends the SDK
// variant's search paths after the target's own LIBRARY_SEARCH_PATHS, rejects DT_TOOLCHAIN_DIR in a
// search path, and a target-level TOOLCHAINS loses to Xcode's. So TOOLCHAIN_DIR names Xcode's own
// toolchain here. The cost: with a custom Swift toolchain selected, settings built on TOOLCHAIN_DIR
// still point into Xcode's for this target, which only loads the Catalyst plugin.
// RuntimeViewerCatalystService/Shared.xcconfig repeats it; Configurations/AGENTS.md has the note.
TOOLCHAIN_DIR = $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain

// The helper's icon is its own Icon Composer document, with no beta variant; the toolchain picks
// the generated Xcode 26 copy the same way the app's Debug.xcconfig explains.
ASSETCATALOG_COMPILER_APPICON_NAME = CatalystHelperIcon$(RUNTIME_VIEWER_CATALYST_HELPER_ICON_VARIANT_$(XCODE_VERSION_MAJOR))
RUNTIME_VIEWER_CATALYST_HELPER_ICON_VARIANT_2600 = Xcode26

ALLOW_TARGET_PLATFORM_SPECIALIZATION = NO
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = NO
BUILD_LIBRARY_FOR_DISTRIBUTION = NO
CODE_SIGN_ENTITLEMENTS = RuntimeViewerCatalystHelper/RuntimeViewerCatalystHelper.entitlements
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=macosx*] = Apple Development
CODE_SIGN_STYLE = Manual
DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER = NO
DEVELOPMENT_TEAM = $(RUNTIME_VIEWER_DEVELOPMENT_TEAM)
ENABLE_HARDENED_RUNTIME = YES
ENABLE_POINTER_AUTHENTICATION = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = RuntimeViewerCatalystHelper/Info.plist
INFOPLIST_KEY_LSBackgroundOnly = YES
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchStoryboardName = LaunchScreen
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
IPHONEOS_DEPLOYMENT_TARGET = 18.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ONLY_ACTIVE_ARCH = NO
PRODUCT_NAME = $(TARGET_NAME)
SKIP_INSTALL = YES
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2,6
