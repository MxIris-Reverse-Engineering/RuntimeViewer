#include "Shared.xcconfig"

// Debug, plus the RUNTIMEVIEWER_ARM64E compilation condition. Written out in full rather than
// including Debug.xcconfig, so that no setting here has to override one that uses $(inherited).
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
GCC_DYNAMIC_NO_PIC = NO
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG RUNTIMEVIEWER_ARM64E $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
