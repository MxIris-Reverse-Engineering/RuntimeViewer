#include "../Version.xcconfig"

// The framework the app links for SourceEditor. Where FetchSourceEditorScript.sh has put the
// reconstructed SourceEditor frameworks, it compiles the bridge against them and links them; anywhere
// else the bridge compiles out (#if canImport(SourceEditor)) and the framework carries only the
// protocols and a factory that reports SourceEditor unavailable.
//
// Only this target has them on its search path, and it imports them with `internal import`, so the
// app, which links this framework, never loads their modules: SourceEditor's headers and
// UIFoundation's both declare AppKit's private NSScrollViewDelegate, differently, and a module that
// sees both does not compile.
FRAMEWORK_SEARCH_PATHS = $(SRCROOT)/../RuntimeViewerPrecompiledLibraries/SourceEditor/Frameworks
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/Frameworks
// `internal import` keeps a module's dependencies from its clients only when it is built with library
// evolution: without it, the app's dependency scan asks for the SourceEditor modules and fails
// ("Unable to resolve module dependency: 'SourceEditor'").
BUILD_LIBRARY_FOR_DISTRIBUTION = YES

// The Copy SourceEditor Frameworks to Products phase reads the download, which a build without it
// does not have and so cannot declare as an input, and writes into the products directory. The app
// target turns sandboxing off for its own Embed SourceEditor Frameworks phase for the same reason.
ENABLE_USER_SCRIPT_SANDBOXING = NO

CODE_SIGN_STYLE = Manual
DEAD_CODE_STRIPPING = YES
DEFINES_MODULE = YES
DEVELOPMENT_TEAM = $(RUNTIME_VIEWER_DEVELOPMENT_TEAM)
DYLIB_INSTALL_NAME_BASE = @rpath
ENABLE_POINTER_AUTHENTICATION = NO
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSHumanReadableCopyright =
INSTALL_PATH = $(LOCAL_LIBRARY_DIR)/Frameworks
MACOSX_DEPLOYMENT_TARGET = 15.0
ONLY_ACTIVE_ARCH = NO
PRODUCT_BUNDLE_IDENTIFIER = $(RUNTIME_VIEWER_SOURCE_EDITOR_BRIDGE_BUNDLE_IDENTIFIER)
PRODUCT_NAME = $(TARGET_NAME)
SKIP_INSTALL = YES
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 5.0
