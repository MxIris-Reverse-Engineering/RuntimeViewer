#include "../Version.xcconfig"

// The tests link the bridge framework (`@testable import`) and the reconstructed frameworks directly,
// from where FetchSourceEditorScript.sh puts them, without running inside the app. Without that
// download the bridge and the tests compile out (#if canImport(SourceEditor)), and the bundle has
// nothing to run. The search path is set for the arm64 slices only, for the reason the bridge's
// Shared.xcconfig gives: an x86_64 compile that can see the frameworks fails at their headers.
FRAMEWORK_SEARCH_PATHS[arch=arm64*] = $(SRCROOT)/../RuntimeViewerPrecompiledLibraries/SourceEditor/Frameworks
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks $(SRCROOT)/../RuntimeViewerPrecompiledLibraries/SourceEditor/Frameworks

CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = $(RUNTIME_VIEWER_DEVELOPMENT_TEAM)
ENABLE_POINTER_AUTHENTICATION = NO
GENERATE_INFOPLIST_FILE = YES
MACOSX_DEPLOYMENT_TARGET = 15.0
ONLY_ACTIVE_ARCH = NO
PRODUCT_BUNDLE_IDENTIFIER = $(RUNTIME_VIEWER_SOURCE_EDITOR_BRIDGE_BUNDLE_IDENTIFIER).Tests
PRODUCT_NAME = $(TARGET_NAME)
SWIFT_EMIT_LOC_STRINGS = NO
SWIFT_VERSION = 5.0
