#include "Debug.xcconfig"

// arm64e variant of the Debug configuration.
//
// Gives the Debug-arm64e build a fully distinct launch-service identity so it never collides with
// a plain Debug build: this daemon name replaces the one Debug.xcconfig includes.
#include "../ServiceName/Debug-arm64e.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(RUNTIME_VIEWER_APP_DEBUG_ARM64E_BUNDLE_IDENTIFIER)
PRODUCT_NAME = RuntimeViewer-Debug-arm64e

// The arm64e variant embeds its own service, named after its own app identifier.
RUNTIME_VIEWER_LOCAL_RUNTIME_SERVICE_BUNDLE_IDENTIFIER = $(RUNTIME_VIEWER_LOCAL_RUNTIME_SERVICE_DEBUG_ARM64E_BUNDLE_IDENTIFIER)
