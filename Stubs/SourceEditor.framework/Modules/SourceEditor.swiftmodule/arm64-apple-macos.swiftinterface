  public final var priority: SourceEditor.LayoutOverrideProviderPriority {
    get
  }
  public func enableLineNumbers()
  public func disableLineNumbers()
  public var lineNumbersEnabled: Swift.Bool {
    get
    set
  }
  public var emphasizeActiveLines: Swift.Bool {
    get
    set
  }
  public var lineNumberFont: AppKit.NSFont? {
    get
    set
  }
  @objc deinit
}

