  var consumerPriority: SourceEditor.SourceEditorEventConsumerPriority { get }
  func didAddToSourceEditorView(_ sourceEditorView: SourceEditor.SourceEditorView)
  func willRemoveFromSourceEditorView(_ sourceEditorView: SourceEditor.SourceEditorView)
}

