// The cheap way to color text ourselves. The alternative — supplying a whole
// `SourceEditorLanguageService`, which is what the framework's own syntax coloring goes
// through — is a 48-requirement protocol; this one has two, and the second has a default.
//
// Registration is via `SourceEditorLayoutManager.addLayoutOverrideProvider(_:)`: the layout
// manager sorts a provider into its buckets by dynamic cast, which is how the framework's own
// `SourceEditorLineAnnotationManager` (conforming to both protocols) is installed.
public protocol TextAttributeOverrideProvider : SourceEditor.LayoutOverrideProvider {
  func textAttributeOverridesForLine(_ line: Swift.Int, in layoutManager: SourceEditor.SourceEditorLayoutManager) -> [SourceEditor.SourceEditorTextAttributeOverride]
  func pasteboardTextAttributeOverridesForLine(_ line: Swift.Int, in layoutManager: SourceEditor.SourceEditorLayoutManager) -> [SourceEditor.SourceEditorTextAttributeOverride]
}

extension SourceEditor.TextAttributeOverrideProvider {
  public func pasteboardTextAttributeOverridesForLine(_ line: Swift.Int, in layoutManager: SourceEditor.SourceEditorLayoutManager) -> [SourceEditor.SourceEditorTextAttributeOverride]
}

