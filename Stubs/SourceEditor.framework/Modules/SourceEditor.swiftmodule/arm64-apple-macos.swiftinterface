public enum SourceEditorEventConsumerPriority {
  case highest
  case high
  case standard
  case low
  case lowest
}

// Requirement order follows the PWT offsets in the dump (0x8, 0x10, 0x18, ...).
// A gap in that sequence would mean a requirement is missing here.
//
// This — not SourceEditorViewCodeNavigationHandler — is the real ⌘-click entry point.
// That handler is only ever read by the framework's Vi*CommandHandler types, i.e. it is
// Vim-mode-only; SourceEditorView.mouseDown(with:) offers the event to the registered
// event consumers and otherwise falls through to its selection controller.
public protocol SourceEditorViewEventConsumer : AnyObject {
  func handleMouseEvent(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView) -> Swift.Bool
  func handleKeyEvent(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView) -> Swift.Bool
  func handleKeyEquivalent(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView) -> Swift.Bool
  func handleFlagsChanged(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView)
  var consumerPriority: SourceEditor.SourceEditorEventConsumerPriority { get }
  func didAddToSourceEditorView(_ sourceEditorView: SourceEditor.SourceEditorView)
  func willRemoveFromSourceEditorView(_ sourceEditorView: SourceEditor.SourceEditorView)
}

extension SourceEditor.SourceEditorViewEventConsumer {
  public func handleMouseEvent(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView) -> Swift.Bool
  public func handleKeyEvent(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView) -> Swift.Bool
  public func handleKeyEquivalent(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView) -> Swift.Bool
  public func handleFlagsChanged(_ event: AppKit.NSEvent, in sourceEditorView: SourceEditor.SourceEditorView)
  public var consumerPriority: SourceEditor.SourceEditorEventConsumerPriority { get }
  public func didAddToSourceEditorView(_ sourceEditorView: SourceEditor.SourceEditorView)
  public func willRemoveFromSourceEditorView(_ sourceEditorView: SourceEditor.SourceEditorView)
}

